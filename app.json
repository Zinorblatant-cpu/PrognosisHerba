{
  "expo": {
    "name": "PrognosisHerba",
    "slug": "PrognosisHerba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prognosisherba.app"
    },
    "android": {
      "package": "com.prognosisherba.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O PrognosisHerba usa sua localização para identificar o trecho da rodovia mais próximo durante o registro de inspeções de poda."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O PrognosisHerba acessa suas fotos para anexar evidências às inspeções de vegetação.",
          "cameraPermission": "O PrognosisHerba usa a câmera para fotografar a vegetação durante as inspeções de campo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1be95951-2af7-40b2-a2a1-558061f88b22"
      }
    }
  }
}
